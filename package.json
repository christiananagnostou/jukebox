{
  "name": "jukebox",
  "description": "A fast, local-first desktop music player",
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.server": "vite build -c adapters/static/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "check:app-identity": "node scripts/check-app-identity.mjs",
    "check:bundle-portability": "node scripts/check-bundle-portability.mjs",
    "check:desktop-security": "node scripts/check-desktop-security.mjs",
    "check:public-source": "node scripts/check-public-source.mjs",
    "check:rust": "cargo fmt --all --manifest-path src-tauri/Cargo.toml -- --check && cargo test --locked --manifest-path src-tauri/Cargo.toml && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "dev": "vite --mode ssr",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "pre-push": "npm run fmt.check && npm run check:public-source && npm run check:app-identity && npm run check:desktop-security && npm test && npm run build && npm run check:rust",
    "test": "vitest run",
    "tauri": "node scripts/run-tauri.mjs"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0",
    "@builder.io/qwik-city": "^1.20.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-qwik": "^1.20.0",
    "happy-dom": "^20.14.0",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2"
  }
}
